---
import MainLayout from '@layouts/MainLayout.astro';
import FormField from '@components/form/FormField.astro';

export const prerender = false;

import {
  CONTRIBUTE_FIELDS,
  HONEYPOT_FIELD,
  isContributionConfigured,
} from '@/lib/contribution';

const numberButtonClass =
  'focus-visible:ring-secondary last:corner-squircle text-ink inline-flex h-10 w-10 touch-manipulation items-center justify-center bg-transparent text-sm font-medium transition duration-300 last:rounded-e-4xl hover:bg-sand focus:outline-hidden focus-visible:ring-1 disabled:pointer-events-none disabled:opacity-50 dark:text-stone-200 dark:hover:bg-stone-800';

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
const formConfigured = isContributionConfigured({
  GITHUB_TOKEN: import.meta.env.GITHUB_TOKEN,
  GITHUB_REPO: import.meta.env.GITHUB_REPO,
  TURNSTILE_SECRET_KEY: import.meta.env.TURNSTILE_SECRET_KEY,
  PROD: import.meta.env.PROD,
});

// Also listed in NOINDEX_PATHS in astro.config.mjs, which keeps this page out of the sitemap.
const NOINDEX = 'noindex, follow';
---

<MainLayout
  title="Contribute a Recipe | OpenStove"
  description="Share your recipe with the OpenStove community via an easy online form."
  robots={NOINDEX}
>
  <section class="mx-auto max-w-2xl px-4 py-16 sm:px-6 lg:py-20">
    <h1 class="text-ink text-3xl font-bold text-balance sm:text-4xl dark:text-stone-100">
      Contribute a recipe
    </h1>
    <p class="mt-4 text-muted 2xl:text-lg dark:text-stone-400">
      Submit a recipe for review. We'll turn it into Markdown, add a licensed
      photo when needed, and publish it on OpenStove. Prefer Git?{' '}
      <a
        class="text-ink dark:hover:text-primary underline decoration-2 underline-offset-2 hover:text-secondary-ink dark:text-stone-200"
        href="https://github.com/mearashadowfax/OpenStove/blob/main/CONTRIBUTING.md"
        target="_blank"
        rel="noopener noreferrer"
      >
        Open a pull request
      </a>{' '}
      instead.
    </p>

    {!formConfigured && (
      <p
        class="corner-squircle mt-6 rounded-4xl border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-900 dark:border-amber-700/50 dark:bg-amber-950/40 dark:text-amber-100"
        role="status"
      >
        Form submission is not configured on this environment yet (GITHUB_TOKEN
        / GITHUB_REPO, plus TURNSTILE_SECRET_KEY in production). You can still
        use the GitHub PR flow.
      </p>
    )}

    <form
      id="contribute-form"
      class="mt-10 space-y-6"
      method="POST"
      action="/api/contribute"
    >
      <div class="grid gap-6 sm:grid-cols-2">
        {CONTRIBUTE_FIELDS.map(field => (
          <div class:list={[field.width === 'half' ? '' : 'sm:col-span-2']}>
            {field.kind === 'checkbox' ? (
              <div class="sm:pt-7">
                <label class="text-ink flex items-center gap-3 text-sm font-medium dark:text-stone-200">
                  <input
                    id={field.name}
                    name={field.name}
                    type="checkbox"
                    class="accent-secondary h-4 w-4 dark:accent-primary"
                  />
                  {field.label}
                </label>
                {field.description && (
                  <p class="mt-1.5 text-xs text-stone-500 dark:text-stone-400">
                    {field.description}
                  </p>
                )}
              </div>
            ) : (
              <FormField
                label={field.label}
                for={field.name}
                required={field.required}
                description={field.description}
              >
                {field.kind === 'textarea' ? (
                  <textarea
                    class:list={[
                      'form-control',
                      field.mono && 'font-mono text-sm',
                    ]}
                    id={field.name}
                    name={field.name}
                    required={field.required}
                    rows={field.rows}
                    maxlength={field.max}
                    placeholder={field.placeholder}
                  ></textarea>
                ) : field.kind === 'number' ? (
                  <div
                    class="corner-squircle focus-within:border-secondary focus-within:ring-secondary/50 dark:focus-within:border-primary dark:focus-within:ring-primary/40 max-w-48 rounded-4xl border border-sand-dark bg-white transition-[box-shadow,border-color] focus-within:ring-3 dark:border-stone-600 dark:bg-stone-900"
                    data-hs-input-number={JSON.stringify({
                      min: field.min,
                      max: field.max,
                    })}
                  >
                    <div class="flex w-full items-center justify-between gap-x-1">
                      <div class="grow px-3 py-2">
                        <input
                          class="text-ink w-full [appearance:textfield] border-0 bg-transparent p-0 outline-hidden focus:ring-0 disabled:opacity-50 dark:text-stone-100 [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none"
                          id={field.name}
                          name={field.name}
                          type="number"
                          value={field.defaultValue}
                          min={field.min}
                          max={field.max}
                          required={field.required}
                          aria-roledescription="Number field"
                          data-hs-input-number-input
                        />
                      </div>
                      <div class="flex items-center divide-x divide-sand-dark border-s border-sand-dark dark:divide-stone-600 dark:border-stone-600">
                        <button
                          type="button"
                          class={numberButtonClass}
                          aria-label="Decrease"
                          data-hs-input-number-decrement
                        >
                          <svg
                            class="h-3.5 w-3.5 shrink-0"
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                          >
                            <path d="M5 12h14" />
                          </svg>
                        </button>
                        <button
                          type="button"
                          class={numberButtonClass}
                          aria-label="Increase"
                          data-hs-input-number-increment
                        >
                          <svg
                            class="h-3.5 w-3.5 shrink-0"
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                          >
                            <path d="M5 12h14" />
                            <path d="M12 5v14" />
                          </svg>
                        </button>
                      </div>
                    </div>
                  </div>
                ) : (
                  <input
                    class="form-control"
                    id={field.name}
                    name={field.name}
                    type={field.kind}
                    required={field.required}
                    maxlength={field.max}
                    placeholder={field.placeholder}
                  />
                )}
              </FormField>
            )}
          </div>
        ))}
      </div>

      {/* Honeypot */}
      <div class="hidden" aria-hidden="true">
        <label for={HONEYPOT_FIELD}>Website</label>
        <input
          id={HONEYPOT_FIELD}
          name={HONEYPOT_FIELD}
          type="text"
          tabindex="-1"
          autocomplete="off"
        />
      </div>

      {turnstileSiteKey && (
        <div
          class="cf-turnstile"
          data-sitekey={turnstileSiteKey}
          data-theme="auto"
        />
      )}

      <p
        id="form-status"
        class="hidden text-sm"
        role="status"
        aria-live="polite"
      ></p>

      <div class="flex flex-wrap items-center gap-3">
        <a
          id="form-result-link"
          class="bg-primary text-ink hover:bg-primary-accent-light focus-visible:ring-primary corner-squircle hidden w-fit items-center justify-center rounded-4xl px-5 py-2.5 font-medium transition-colors focus-visible:ring-2 focus-visible:outline-hidden"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
        >
          View submission on GitHub
        </a>

        <button
          type="submit"
          id="contribute-submit"
          disabled={!formConfigured}
          class="bg-secondary text-ink hover:bg-secondary-dark focus-visible:ring-secondary corner-squircle inline-flex items-center justify-center rounded-4xl px-5 py-2.5 font-medium transition-colors focus-visible:ring-2 focus-visible:outline-hidden disabled:cursor-not-allowed disabled:opacity-50 dark:bg-primary dark:hover:bg-primary-accent-dark dark:focus-visible:ring-primary"
        >
          Submit for review
        </button>
      </div>
    </form>
  </section>
</MainLayout>

{turnstileSiteKey && (
  <script
    is:inline
    src="https://challenges.cloudflare.com/turnstile/v0/api.js"
    async
    defer
  ></script>
)}

<script>
  const form = document.getElementById(
    'contribute-form'
  ) as HTMLFormElement | null;
  const statusEl = document.getElementById('form-status');
  const submitBtn = document.getElementById(
    'contribute-submit'
  ) as HTMLButtonElement | null;
  const resultLink = document.getElementById(
    'form-result-link'
  ) as HTMLAnchorElement | null;

  form?.addEventListener('submit', async event => {
    event.preventDefault();
    if (!form || !statusEl || !submitBtn) return;

    statusEl.classList.add('hidden');
    resultLink?.classList.add('hidden');
    resultLink?.classList.remove('inline-flex');
    submitBtn.disabled = true;
    submitBtn.textContent = 'Submitting…';

    try {
      const response = await fetch('/api/contribute', {
        method: 'POST',
        body: new FormData(form),
      });
      let data: { ok?: boolean; error?: string; url?: string } = {};
      try {
        data = await response.json();
      } catch {
        // A proxy error page (e.g. a 413 from the host) is not JSON.
      }

      if (!response.ok || !data.ok) {
        throw new Error(data.error || 'Submission failed. Please try again.');
      }

      statusEl.textContent = 'Thanks! Your recipe was submitted for review.';
      statusEl.className = 'text-sm text-green-700 dark:text-green-400';
      if (data.url && resultLink) {
        resultLink.href = data.url;
        resultLink.classList.remove('hidden');
        resultLink.classList.add('inline-flex');
      }
      form.reset();
    } catch (error) {
      resultLink?.classList.add('hidden');
      resultLink?.classList.remove('inline-flex');
      statusEl.textContent =
        error instanceof Error ? error.message : 'Something went wrong.';
      statusEl.className = 'text-sm text-red-700 dark:text-red-400';
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Submit for review';
    }
  });
</script>
