---
import MainLayout from '@layouts/MainLayout.astro';
import RecipeGrid from '@components/RecipeGrid.astro';
import EmptyState from '@components/EmptyState.astro';
import { getCollection } from 'astro:content';
import { byIds, listRecipes } from '@/lib/catalogue';
import { BOOKMARKS_COOKIE, parseBookmarks } from '@/lib/bookmarks';

export const prerender = false;

const savedIds = parseBookmarks(Astro.cookies.get(BOOKMARKS_COOKIE)?.value);

const saved = listRecipes(byIds(await getCollection('recipes'), savedIds), {
  perPage: Number.MAX_SAFE_INTEGER,
});

// Also listed in NOINDEX_PATHS in astro.config.mjs, which keeps this page out of the sitemap.
const NOINDEX = 'noindex, follow';
---

<MainLayout
  title="Saved Recipes | OpenStove"
  description="View your saved recipes on OpenStove. Access your bookmarked recipes anytime."
  canonicalUrl="/recipes/saved"
  robots={NOINDEX}
>
  <section class="min-h-screen">
    <div class="mt-10 py-6 sm:py-8 lg:py-12">
      <div class="corner-squircle from-brand-gold to-brand-warm rounded-[100px] bg-linear-to-r px-4 py-6 md:py-8 lg:py-12">
        <h1 class="text-ink mx-auto max-w-3xl text-center text-3xl font-bold text-balance sm:text-4xl md:text-5xl 2xl:max-w-4xl 2xl:text-6xl">
          Saved recipes
        </h1>
      </div>
    </div>

    <RecipeGrid page={saved}>
      <EmptyState
        slot="empty"
        title="No saved recipes yet"
        description="Tap the bookmark icon on any recipe to save it here. Bookmarks are stored in a cookie in this browser."
        primaryHref="/recipes"
        primaryLabel="Browse recipes"
      />
    </RecipeGrid>
  </section>
</MainLayout>
