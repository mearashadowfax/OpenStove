---
import MainLayout from '@layouts/MainLayout.astro';
import Stepper from '@components/Stepper.astro';
import Tabs from '@components/Tabs.astro';
import Tags from '@components/Tags.astro';
import InputNumber from '@components/InputNumber.astro';
import Bookmark from '@components/Bookmark.astro';
import Clipboard from '@components/Clipboard.astro';
import RecipeImage from '@components/RecipeImage.astro';
import PrintRecipe from '@components/PrintRecipe.astro';
import { formatDate } from '@utils';
import { resolveRecipeImage } from '@/lib/recipeImage';
import { getCollection, getEntry } from 'astro:content';
import type { GetStaticPaths } from 'astro';

export const prerender = true;

export const getStaticPaths = (async () => {
  const recipes = await getCollection('recipes');
  return recipes.map(recipe => ({
    params: { slug: recipe.id },
  }));
}) satisfies GetStaticPaths;

const { slug } = Astro.params;

if (slug === undefined) {
  throw new Error('Slug is required');
}

const entry = await getEntry('recipes', slug);

if (entry === undefined) {
  return Astro.redirect('/404');
}

const recipeUrl = Astro.url.href;
const recipeTitle = entry.data.title + ' | OpenStove';
const recipeDescription =
  entry.data.description ||
  `Learn how to make ${entry.data.title} with this delicious recipe from OpenStove.`;
const recipeImage = resolveRecipeImage(entry.data.image);
const recipePath = Astro.url.pathname;
---

<MainLayout
  title={recipeTitle}
  description={recipeDescription}
  image={recipeImage}
  type="article"
  url={recipeUrl}
  recipeData={{
    author: entry.data.author,
    pubDate: entry.data.pubDate,
    cookingTime: entry.data.cookingTime,
    servings: entry.data.servings,
    ingredients: entry.data.ingredients,
    steps: entry.data.steps,
  }}
>
  <section class="recipe-print-root mt-10 pt-6 sm:pt-8 lg:pt-12">
    <div class="recipe-print-brand" aria-hidden="true">
      <span>OpenStove</span>
      <span>Community-crafted recipes</span>
    </div>

    {/* Image Start */}
    <div class="recipe-screen-image mx-auto min-w-full bg-cover">
      <RecipeImage
        image={entry.data.image}
        imageAlt={entry.data.imageAlt}
        class="recipe-hero-image corner-squircle h-80 w-full rounded-[50px] object-cover"
        draggable="false"
        loading="eager"
        width={1600}
        height={900}
        sizes="100vw"
      />
    </div>

    {/* Title Start */}
    <h1
      class="text-dark mx-auto mt-10 mb-4 max-w-3xl text-center text-3xl font-bold text-balance sm:text-4xl md:mb-6 md:text-6xl 2xl:max-w-4xl 2xl:text-7xl dark:text-stone-100"
    >
      {entry.data.title}
    </h1>

    {
      entry.data.description && (
        <p class="mx-auto mb-6 max-w-2xl text-center text-pretty text-stone-600 md:mb-8 md:text-lg 2xl:text-xl dark:text-stone-400">
          {entry.data.description}
        </p>
      )
    }

    {/* Top Bar Container */}
    <div
      class="recipe-print-meta mx-auto grid max-w-(--breakpoint-lg) gap-y-5 lg:flex lg:items-center lg:justify-between lg:gap-y-0"
    >
      {/* Author/Date */}
      <div>
        <ul>
          <li
            class="text-dark relative inline-block pe-6 text-base before:absolute before:end-2 before:top-1/2 before:h-1 before:w-1 before:-translate-y-1/2 before:rounded-full before:bg-stone-400 last:pe-0 last-of-type:before:hidden dark:text-stone-100 dark:before:bg-stone-600"
          >
            {entry.data.author}
          </li>
          <li
            class="relative inline-block pe-6 text-xs text-stone-500 before:absolute before:end-2 before:top-1/2 before:h-1 before:w-1 before:-translate-y-1/2 before:rounded-full before:bg-stone-400 last:pe-0 last-of-type:before:hidden 2xl:text-sm dark:text-stone-400 dark:before:bg-stone-600"
          >
            {formatDate(entry.data.pubDate)}
          </li>
        </ul>
      </div>

      {/* Time/Print/Bookmark */}
      <div class="flex items-center justify-end gap-x-1.5">
        <div class="inline-flex max-w-xs gap-x-2">
          <span
            class="font-regular group text-dark inline-flex items-center gap-x-2 p-3 text-sm 2xl:text-base dark:text-stone-100"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              class="h-5 w-5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"></path>
            </svg>
            {entry.data.cookingTime} min
          </span>
        </div>

        <div
          class="no-print mx-3 block h-4 border-e border-stone-400 dark:border-stone-500"
        >
        </div>

        <div class="no-print inline-flex items-center gap-x-1">
          <PrintRecipe />
          <Bookmark />
        </div>
      </div>
    </div>
  </section>

  <div class="recipe-print-body mx-auto max-w-(--breakpoint-lg)">
    <div
      class="recipe-print-columns grid gap-y-8 lg:grid-cols-3 lg:gap-x-12 lg:gap-y-0"
    >
      <div class="recipe-print-main lg:col-span-2">
        {/* Instructions Section */}
        <section class="py-6 sm:py-8 lg:py-12">
          <div class="mx-auto max-w-(--breakpoint-lg)">
            <h2
              class="text-dark text-3xl font-semibold lg:text-4xl dark:text-stone-100"
            >
              Instructions:
            </h2>

            <Tabs />

            {/* Segment 1 */}
            <div class="mt-3">
              <div
                id="segment-1"
                role="tabpanel"
                aria-labelledby="segment-item-1"
              >
                <Stepper recipe={entry} />
              </div>
            </div>

            {/* Segment 2 / View All Recipe */}
            <div
              id="segment-2"
              class="hidden"
              role="tabpanel"
              aria-labelledby="segment-item-2"
            >
              <ol class="max-w-prose list-inside list-decimal space-y-6">
                {
                  entry.data.steps?.map(step => (
                    <li class="text-dark text-lg font-bold text-balance 2xl:text-xl dark:text-stone-200">
                      {step.title}
                      <ul class="marker:text-secondary dark:marker:text-primary mt-1 list-disc space-y-2 ps-5 leading-normal font-normal text-pretty text-stone-600 2xl:text-xl dark:text-stone-400">
                        {step.actions.map(action => (
                          <li>{action}</li>
                        ))}
                      </ul>
                    </li>
                  ))
                }
              </ol>
            </div>
          </div>
        </section>

        {/* Recipe Notes Section */}
        <section class="py-6 sm:py-8 lg:py-12">
          {
            entry.data.recipeNotes && entry.data.recipeNotes?.length > 0 ? (
              <div class="mx-auto max-w-(--breakpoint-lg)">
                <h2 class="text-dark text-3xl font-semibold lg:text-4xl dark:text-stone-100">
                  Recipe notes:
                </h2>
                <ul class="marker:text-secondary dark:marker:text-primary mt-4 max-w-prose list-disc space-y-2 ps-5 text-lg leading-normal text-pretty text-stone-600 2xl:text-xl dark:text-stone-400">
                  {entry.data.recipeNotes?.map((note: string) => (
                    <li>{note}</li>
                  ))}
                </ul>
              </div>
            ) : (
              ''
            )
          }
        </section>
      </div>

      {/* Sidebar */}
      <div class="recipe-print-ingredients lg:col-span-1 lg:h-full lg:w-full">
        {/* Ingredients Section */}
        <section class="mx-auto max-w-(--breakpoint-lg) py-6 sm:py-8 lg:py-12">
          <h2
            class="text-dark text-3xl font-semibold lg:text-4xl dark:text-stone-100"
          >
            Ingredients:
          </h2>
          <InputNumber recipe={entry} />
        </section>
      </div>
    </div>
  </div>
  {/* Bottom Bar Container */}
  <div
    class="recipe-tags mx-auto grid max-w-(--breakpoint-lg) gap-y-5 sm:flex sm:items-center sm:justify-between sm:gap-y-0"
  >
    {/* Badges/Tags */}
    <div
      class="flex flex-wrap gap-x-2 gap-y-1 sm:flex-nowrap sm:items-center sm:gap-y-0"
    >
      <Tags tags={entry.data.tags} />
    </div>

    {/* Copy/Print/Bookmark */}
    <div class="no-print flex items-center justify-end gap-x-1.5">
      <Clipboard />
      <div
        class="mx-3 block h-4 border-e border-stone-400 dark:border-stone-500"
      >
      </div>
      <div class="inline-flex items-center gap-x-1">
        <PrintRecipe />
        <Bookmark />
      </div>
    </div>
    {/* End Bottom Bar Container */}
  </div>

  <footer class="recipe-print-source" aria-hidden="true">
    <span>OpenStove</span>
    <span>{`openstove.org${recipePath}`}</span>
  </footer>
</MainLayout>
