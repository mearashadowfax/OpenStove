---
import MainLayout from '@layouts/MainLayout.astro';
import RecipeCard from '@components/RecipeCard.astro';
import EmptyState from '@components/EmptyState.astro';
import { tagHref, tagLabel } from '@/lib/tag';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import type { GetStaticPaths } from 'astro';

export const prerender = true;

export const getStaticPaths = (async () => {
  const allRecipes = await getCollection('recipes');
  const tags = new Set<string>();

  for (const recipe of allRecipes) {
    for (const tag of recipe.data.tags ?? []) {
      tags.add(tag);
    }
  }

  return [...tags].map(tag => ({
    params: { tag },
  }));
}) satisfies GetStaticPaths;

const { tag: tagParam } = Astro.params;

if (tagParam === undefined) {
  throw new Error('Tag is required');
}

const tag = decodeURIComponent(tagParam);

const allRecipes: CollectionEntry<'recipes'>[] = (
  await getCollection('recipes')
).sort(
  (a: CollectionEntry<'recipes'>, b: CollectionEntry<'recipes'>) =>
    b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const tagRecipes = allRecipes.filter(recipe =>
  (recipe.data.tags ?? []).includes(tag)
);

const canonicalUrl = tagHref(tag);
const pageTitle = `${tagLabel(tag)} | OpenStove`;
const pageDescription = `Browse ${tagRecipes.length} ${tag} recipes on OpenStove. Discover community-crafted recipes for ${tag} dishes.`;
---

<MainLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
>
  <section class="min-h-screen">
    <div class="mt-10 py-6 sm:py-8 lg:py-12">
      <div
        class="corner-squircle from-brand-warm to-brand-gold rounded-[100px] bg-linear-to-r px-4 py-6 md:py-8 lg:py-12"
      >
        <h1
          class="text-dark mx-auto max-w-3xl text-center text-3xl font-bold text-balance sm:text-4xl md:text-5xl 2xl:max-w-4xl 2xl:text-6xl"
        >
          {tagLabel(tag)}
        </h1>
      </div>
    </div>

    <div id="recipeCards" class="mx-auto max-w-(--breakpoint-2xl)">
      {
        tagRecipes.length === 0 ? (
          <EmptyState
            title={`No recipes tagged “${tagLabel(tag)}”`}
            description="This tag does not have any recipes yet. Explore the full collection instead."
            primaryHref="/recipes"
            primaryLabel="Browse recipes"
          />
        ) : (
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {tagRecipes.map(recipe => (
              <RecipeCard recipe={recipe} />
            ))}
          </div>
        )
      }
    </div>
  </section>
</MainLayout>
