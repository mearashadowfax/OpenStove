---
import MainLayout from '@layouts/MainLayout.astro';
import RecipeGrid from '@components/RecipeGrid.astro';
import EmptyState from '@components/EmptyState.astro';
import { getCollection } from 'astro:content';
import {
  MIN_QUERY_LENGTH,
  listRecipes,
  parsePage,
  queryPaging,
  searchRecipes,
} from '@/lib/catalogue';

export const prerender = false;

const query = Astro.url.searchParams.get('query')?.trim() ?? '';
const hasQuery = query.length >= MIN_QUERY_LENGTH;

const results = listRecipes(
  searchRecipes(await getCollection('recipes'), query),
  {
    order: 'given',
    page: parsePage(Astro.url.searchParams.get('page')),
    pathFor: queryPaging('/recipes/search', { query }),
  }
);

const canonicalUrl = '/recipes/search';
const pageDescription = hasQuery
  ? `Search results for "${query}" on OpenStove. Found ${results.totalItems} recipes.`
  : 'Search recipes on OpenStove. Find your favorite dishes from our community-crafted collection.';

const heading = hasQuery ? `Results for “${query}”` : 'Search recipes';

const emptyState = hasQuery
  ? {
      title: `No recipes match “${query}”`,
      description:
        'Try a shorter phrase, a different dish name, or browse the full collection.',
      primaryHref: '/recipes',
      primaryLabel: 'Browse recipes',
      secondaryHref: '/',
      secondaryLabel: 'Back to home',
    }
  : {
      title: 'Search the recipe library',
      description:
        'Type at least two characters in the search bar above to find recipes by title, ingredients, tags, or instructions.',
      primaryHref: '/recipes',
      primaryLabel: 'Browse all recipes',
    };
---

<MainLayout
  title={
    hasQuery
      ? `Search Results for "${query}" | OpenStove`
      : 'Search | OpenStove'
  }
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  robots="noindex, follow"
>
  <section class="min-h-screen">
    <div class="mt-10 py-6 sm:py-8 lg:py-12">
      <div class="corner-squircle from-brand-warm to-brand-gold rounded-[100px] bg-linear-to-r px-4 py-6 md:py-8 lg:py-12">
        <h1 class="text-dark mx-auto max-w-3xl text-center text-3xl font-bold text-balance sm:text-4xl md:text-5xl 2xl:max-w-4xl 2xl:text-6xl">
          {heading}
        </h1>
      </div>
    </div>

    <RecipeGrid page={results}>
      <EmptyState slot="empty" {...emptyState} />
    </RecipeGrid>
  </section>
</MainLayout>
