---
import SearchBar from './SearchBar.astro';
import { Icon } from 'astro-icon/components';
import Logo from './Logo.astro';

const pathname = new URL(Astro.request.url).pathname;
const currentPage = pathname.slice(1);

const links = [
  { href: '/', label: 'Home', isActive: currentPage === '' },
  {
    href: '/recipes',
    label: 'Recipes',
    isActive: currentPage.startsWith('recipes'),
  },
  {
    href: '/contribute',
    label: 'Contribute',
    isActive: currentPage.startsWith('contribute'),
  },
  { href: '/about', label: 'About', isActive: currentPage.startsWith('about') },
];

// Below xl the links are a stacked menu with a gold pill for the current page;
// from xl they sit inline and the current page gets a coral underline (gold in dark).
const linkBase =
  'block corner-squircle rounded-4xl px-3 py-2 text-ink transition-colors duration-300 focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-secondary xl:relative xl:p-0 xl:after:absolute xl:after:inset-x-0 xl:after:-bottom-0.5 xl:after:h-0.5 xl:after:rounded-full 2xl:text-lg dark:text-stone-100 xl:dark:bg-transparent';
const linkActive =
  'bg-primary-accent-dark font-medium xl:bg-transparent xl:after:bg-secondary dark:bg-stone-900 xl:dark:after:bg-primary';
const linkInactive =
  'hover:bg-sand xl:hover:bg-transparent xl:after:bg-transparent xl:after:transition-colors xl:after:duration-300 xl:hover:after:bg-sand-dark dark:hover:bg-dark xl:dark:hover:bg-transparent xl:dark:hover:after:bg-stone-600';
---

{/* Nav Bar */}
<header class="dark:bg-dark/80 fixed start-0 top-0 z-20 w-full border-b border-sand-dark/60 bg-cream/70 backdrop-blur-md dark:border-stone-700/40 dark:backdrop-blur-md">
  <nav
    class="mx-auto flex w-full max-w-(--breakpoint-2xl) basis-full flex-wrap items-center justify-between px-4 py-2.5 xl:px-8"
    aria-label="Primary"
  >
    {/* Logo SVG */}
    <a
      class="focus-visible:ring-secondary hidden items-center space-x-3 rounded-md focus-visible:ring-2 focus-visible:outline-hidden xl:flex rtl:space-x-reverse"
      href="/"
      aria-label="OpenStove home"
    >
      <Logo class="h-auto w-28" />
    </a>
    {/* End Logo SVG */}
    <div class="flex w-full items-center justify-between gap-x-2 xl:order-3 xl:w-auto xl:justify-normal">
      {/* Hamburger Button */}
      <div class="flex shrink-0 items-center justify-start">
        <button
          type="button"
          class="hs-collapse-toggle focus-visible:ring-secondary corner-squircle inline-flex h-10 w-10 items-center justify-center rounded-4xl py-2 whitespace-nowrap transition-colors duration-300 hover:bg-sand focus:outline-hidden focus-visible:ring-1 focus-visible:outline-hidden xl:hidden dark:hover:bg-stone-700"
          data-hs-collapse="#navbar-alignment"
          aria-controls="navbar-alignment"
          aria-expanded="false"
          aria-label="Toggle navigation"
        >
          <svg
            class="hs-collapse-open:hidden h-5 w-5"
            fill="none"
            id="open-menu-icon"
            stroke-width="1.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              class="text-ink fill-current dark:text-stone-100"
              d="M3 5H11"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
            ></path>
            <path
              class="text-ink fill-current dark:text-stone-100"
              d="M3 12H16"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
            ></path>
            <path
              class="text-ink fill-current dark:text-stone-100"
              d="M3 19H21"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
            ></path>
          </svg>
          <svg
            class="hs-collapse-open:block hidden h-6 w-6"
            fill="none"
            id="close-menu-icon"
            stroke="currentColor"
            stroke-width="1.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              class="text-ink fill-current dark:text-stone-100"
              d="M6 18 18 6M6 6l12 12"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
            ></path>
          </svg>
        </button>
      </div>
      {/* End Hamburger Button */}
      <div class="flex min-w-0 flex-1 items-center justify-end xl:w-auto xl:flex-none">
        {/*    Search Bar*/}
        <SearchBar />

        {/* Github Icon*/}
        <a
          class="focus-visible:ring-secondary corner-squircle inline-flex h-10 min-w-10 items-center justify-center rounded-4xl py-2 whitespace-nowrap transition-colors duration-300 hover:bg-sand focus:outline-hidden focus-visible:ring-1 focus-visible:outline-hidden xl:h-9 xl:w-9 xl:min-w-0 dark:hover:bg-stone-700"
          href="https://github.com/mearashadowfax/OpenStove"
          target="_blank"
          aria-label="Visit GitHub"
        >
          <svg class="h-[1.2rem] w-[1.2rem]" viewBox="0 0 438.549 438.549">
            <path
              class="text-ink fill-current dark:text-stone-100"
              d="M409.132 114.573c-19.608-33.596-46.205-60.194-79.798-79.8-33.598-19.607-70.277-29.408-110.063-29.408-39.781 0-76.472 9.804-110.063 29.408-33.596 19.605-60.192 46.204-79.8 79.8C9.803 148.168 0 184.854 0 224.63c0 47.78 13.94 90.745 41.827 128.906 27.884 38.164 63.906 64.572 108.063 79.227 5.14.954 8.945.283 11.419-1.996 2.475-2.282 3.711-5.14 3.711-8.562 0-.571-.049-5.708-.144-15.417a2549.81 2549.81 0 01-.144-25.406l-6.567 1.136c-4.187.767-9.469 1.092-15.846 1-6.374-.089-12.991-.757-19.842-1.999-6.854-1.231-13.229-4.086-19.13-8.559-5.898-4.473-10.085-10.328-12.56-17.556l-2.855-6.57c-1.903-4.374-4.899-9.233-8.992-14.559-4.093-5.331-8.232-8.945-12.419-10.848l-1.999-1.431c-1.332-.951-2.568-2.098-3.711-3.429-1.142-1.331-1.997-2.663-2.568-3.997-.572-1.335-.098-2.43 1.427-3.289 1.525-.859 4.281-1.276 8.28-1.276l5.708.853c3.807.763 8.516 3.042 14.133 6.851 5.614 3.806 10.229 8.754 13.846 14.842 4.38 7.806 9.657 13.754 15.846 17.847 6.184 4.093 12.419 6.136 18.699 6.136 6.28 0 11.704-.476 16.274-1.423 4.565-.952 8.848-2.383 12.847-4.285 1.713-12.758 6.377-22.559 13.988-29.41-10.848-1.14-20.601-2.857-29.264-5.14-8.658-2.286-17.605-5.996-26.835-11.14-9.235-5.137-16.896-11.516-22.985-19.126-6.09-7.614-11.088-17.61-14.987-29.979-3.901-12.374-5.852-26.648-5.852-42.826 0-23.035 7.52-42.637 22.557-58.817-7.044-17.318-6.379-36.732 1.997-58.24 5.52-1.715 13.706-.428 24.554 3.853 10.85 4.283 18.794 7.952 23.84 10.994 5.046 3.041 9.089 5.618 12.135 7.708 17.705-4.947 35.976-7.421 54.818-7.421s37.117 2.474 54.823 7.421l10.849-6.849c7.419-4.57 16.18-8.758 26.262-12.565 10.088-3.805 17.802-4.853 23.134-3.138 8.562 21.509 9.325 40.922 2.279 58.24 15.036 16.18 22.559 35.787 22.559 58.817 0 16.178-1.958 30.497-5.853 42.966-3.9 12.471-8.941 22.457-15.125 29.979-6.191 7.521-13.901 13.85-23.131 18.986-9.232 5.14-18.182 8.85-26.84 11.136-8.662 2.286-18.415 4.004-29.263 5.146 9.894 8.562 14.842 22.077 14.842 40.539v60.237c0 3.422 1.19 6.279 3.572 8.562 2.379 2.279 6.136 2.95 11.276 1.995 44.163-14.653 80.185-41.062 108.068-79.226 27.88-38.161 41.825-81.126 41.825-128.906-.01-39.771-9.818-76.454-29.414-110.049z"
              fill="currentColor"
            ></path>
          </svg>
        </a>
        {/*Dark Mode Button toggle*/}

        <button
          type="button"
          aria-label="Switch to dark mode"
          class="hs-dark-mode group focus-visible:ring-secondary hs-dark-mode-active:hidden corner-squircle inline-flex h-10 min-w-10 items-center justify-center rounded-4xl py-2 whitespace-nowrap transition-colors duration-300 hover:bg-sand focus:outline-hidden focus-visible:ring-1 focus-visible:outline-hidden xl:h-9 xl:w-9 xl:min-w-0 dark:hover:bg-stone-700"
          data-hs-theme-click-value="dark"
        >
          <Icon name="moon" class="mx-auto h-[1.2rem] w-[1.2rem]" />
        </button>

        <button
          type="button"
          aria-label="Switch to light mode"
          class="hs-dark-mode group focus-visible:ring-secondary hs-dark-mode-active:inline-flex corner-squircle hidden h-10 min-w-10 items-center justify-center rounded-4xl py-2 whitespace-nowrap transition-colors duration-300 hover:bg-sand focus:outline-hidden focus-visible:ring-1 focus-visible:outline-hidden xl:h-9 xl:w-9 xl:min-w-0 dark:hover:bg-stone-700"
          data-hs-theme-click-value="light"
        >
          <Icon name="sun" class="mx-auto h-5 w-5" />
        </button>
      </div>
    </div>

    <div
      id="navbar-alignment"
      class="hs-collapse hidden grow basis-full overflow-hidden transition-all duration-300 xl:order-2 xl:block xl:grow-0 xl:basis-auto xl:overflow-visible"
    >
      <ul class="corner-squircle mt-4 flex flex-col rounded-4xl border border-sand-dark p-4 font-medium transition-colors duration-300 xl:mt-0 xl:flex-row xl:gap-8 xl:border-0 xl:p-0.5 2xl:text-lg rtl:space-x-reverse dark:border-stone-700">
        <li class="my-3 flex items-center justify-center xl:hidden">
          <a
            class="focus-visible:ring-secondary rounded-md focus-visible:ring-2 focus-visible:outline-hidden"
            href="/"
            aria-label="OpenStove home"
          >
            <Logo class="h-auto w-36" />
          </a>
        </li>
        {links.map(({ href, label, isActive }) => (
          <li>
            <a
              href={href}
              data-astro-prefetch
              aria-current={isActive ? 'page' : undefined}
              class:list={[linkBase, isActive ? linkActive : linkInactive]}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>
</header>
{/* End Nav Bar */}

<script is:inline>
  const HSThemeAppearance = {
    init() {
      const defaultTheme = 'default';
      let theme = localStorage.getItem('hs_theme') || defaultTheme;

      if (document.querySelector('html').classList.contains('dark')) return;
      this.setAppearance(theme);
    },
    _resetStylesOnLoad() {
      const $resetStyles = document.createElement('style');
      $resetStyles.innerText = `*{transition: unset !important;}`;
      $resetStyles.setAttribute('data-hs-appearance-onload-styles', '');
      document.head.appendChild($resetStyles);
      return $resetStyles;
    },
    setAppearance(theme, saveInStore = true, dispatchEvent = true) {
      const $resetStylesEl = this._resetStylesOnLoad();

      if (saveInStore) {
        localStorage.setItem('hs_theme', theme);
      }

      if (theme === 'auto') {
        theme = window.matchMedia('(prefers-color-scheme: dark)').matches
          ? 'dark'
          : 'default';
      }

      document.querySelector('html').classList.remove('dark');
      document.querySelector('html').classList.remove('default');
      document.querySelector('html').classList.remove('auto');

      document
        .querySelector('html')
        .classList.add(this.getOriginalAppearance());

      setTimeout(() => {
        $resetStylesEl.remove();
      });

      if (dispatchEvent) {
        window.dispatchEvent(
          new CustomEvent('on-hs-appearance-change', { detail: theme })
        );
      }
    },
    getAppearance() {
      let theme = this.getOriginalAppearance();
      if (theme === 'auto') {
        theme = window.matchMedia('(prefers-color-scheme: dark)').matches
          ? 'dark'
          : 'default';
      }
      return theme;
    },
    getOriginalAppearance() {
      const defaultTheme = 'default';
      return localStorage.getItem('hs_theme') || defaultTheme;
    },
  };
  HSThemeAppearance.init();

  window
    .matchMedia('(prefers-color-scheme: dark)')
    .addEventListener('change', () => {
      if (HSThemeAppearance.getOriginalAppearance() === 'auto') {
        HSThemeAppearance.setAppearance('auto', false);
      }
    });

  window.addEventListener('load', () => {
    const $clickableThemes = document.querySelectorAll(
      '[data-hs-theme-click-value]'
    );
    const $switchableThemes = document.querySelectorAll(
      '[data-hs-theme-switch]'
    );

    $clickableThemes.forEach($item => {
      $item.addEventListener('click', () =>
        HSThemeAppearance.setAppearance(
          $item.getAttribute('data-hs-theme-click-value'),
          true,
          $item
        )
      );
    });

    $switchableThemes.forEach($item => {
      $item.addEventListener('change', e => {
        HSThemeAppearance.setAppearance(e.target.checked ? 'dark' : 'default');
      });

      $item.checked = HSThemeAppearance.getAppearance() === 'dark';
    });

    window.addEventListener('on-hs-appearance-change', e => {
      $switchableThemes.forEach($item => {
        $item.checked = e.detail === 'dark';
      });
    });
  });
</script>
