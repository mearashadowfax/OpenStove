---
interface Props {
  recipeId: string;
}

const { recipeId } = Astro.props;
---

<button
  type="button"
  class="group text-ink focus-visible:ring-secondary corner-squircle inline-flex items-center rounded-4xl p-2.5 hover:bg-sand focus:outline-hidden focus-visible:ring-1 focus-visible:outline-hidden dark:text-stone-100 dark:hover:bg-stone-700"
  data-bookmark-button
  data-recipe-id={recipeId}
  aria-label="Save recipe"
  aria-pressed="false"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    stroke-width="1.5"
    stroke="currentColor"
    class="h-6 w-6 fill-none"
    aria-hidden="true"
  >
    <path
      class="text-ink group-hover:text-secondary-ink dark:group-hover:text-primary dark:text-stone-100"
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0 1 11.186 0Z"
    ></path>
  </svg>
</button>
<span
  class="text-xs text-stone-500 dark:text-stone-400"
  data-bookmark-hint
  role="status"
  hidden
>
  Saved list is full
</span>

<script>
  import {
    BOOKMARKS_COOKIE,
    BOOKMARKS_MAX_AGE_DAYS,
    parseBookmarks,
    serializeBookmarks,
    toggleBookmark,
  } from '@/lib/bookmarks';

  const buttons = document.querySelectorAll<HTMLButtonElement>(
    '[data-bookmark-button]'
  );
  const hints = document.querySelectorAll<HTMLElement>('[data-bookmark-hint]');
  const recipeId = buttons[0]?.dataset.recipeId;

  function readCookie(): string | undefined {
    const prefix = `${BOOKMARKS_COOKIE}=`;
    return document.cookie
      .split(';')
      .map(part => part.trim())
      .find(part => part.startsWith(prefix))
      ?.slice(prefix.length);
  }

  function writeCookie(value: string) {
    const expires = new Date(
      Date.now() + BOOKMARKS_MAX_AGE_DAYS * 24 * 60 * 60 * 1000
    ).toUTCString();
    const secure = location.protocol === 'https:' ? ';Secure' : '';
    document.cookie = `${BOOKMARKS_COOKIE}=${value};expires=${expires};path=/${secure};SameSite=Lax`;
  }

  function render(saved: boolean) {
    buttons.forEach(button => {
      button.classList.toggle('bookmarked', saved);
      button.setAttribute('aria-pressed', String(saved));
      button.setAttribute(
        'aria-label',
        saved ? 'Remove from saved' : 'Save recipe'
      );
      const svg = button.querySelector('svg');
      svg?.setAttribute(
        'class',
        saved ? 'h-6 w-6 fill-secondary dark:fill-primary' : 'h-6 w-6 fill-none'
      );
      svg
        ?.querySelector('path')
        ?.setAttribute(
          'class',
          saved
            ? 'text-secondary-ink dark:text-primary'
            : 'text-ink group-hover:text-secondary-ink dark:text-stone-100 dark:group-hover:text-primary'
        );
    });
  }

  if (recipeId) {
    render(parseBookmarks(readCookie()).includes(recipeId));

    buttons.forEach(button => {
      button.addEventListener('click', () => {
        const result = toggleBookmark(parseBookmarks(readCookie()), recipeId);
        hints.forEach(hint => (hint.hidden = result.status !== 'full'));
        if (result.status === 'full') return;
        writeCookie(serializeBookmarks(result.ids));
        render(result.status === 'added');
      });
    });
  }
</script>
