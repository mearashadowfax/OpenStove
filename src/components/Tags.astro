---
import { tagHref, tagLabel } from '@/lib/tag';
const { tags } = Astro.props;

interface Props {
  tags?: string[];
}
---

{tags?.map((tag: string) => (
  <a
    class="focus-visible:ring-secondary text-olive-dark corner-squircle bg-olive/20 hover:bg-olive/30 inline-flex items-center gap-x-1.5 rounded-4xl px-3 py-1.5 text-xs font-medium transition-colors duration-300 focus:outline-hidden focus-visible:ring-1 focus-visible:outline-hidden xl:text-sm dark:bg-stone-700/60 dark:text-stone-300 dark:hover:bg-stone-600"
    data-astro-prefetch
    href={tagHref(tag)}
  >
    {tagLabel(tag)}
  </a>
))}
