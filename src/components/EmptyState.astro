---
interface Props {
  title: string;
  description: string;
  primaryHref?: string;
  primaryLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
}

const {
  title,
  description,
  primaryHref = '/recipes',
  primaryLabel = 'Browse recipes',
  secondaryHref,
  secondaryLabel,
} = Astro.props;
---

<div class="mx-auto flex max-w-lg flex-col items-center px-4 py-16 text-center">
  <h2 class="text-ink text-xl font-bold text-balance sm:text-2xl dark:text-stone-100">
    {title}
  </h2>
  <p class="mt-3 text-pretty text-muted dark:text-stone-400">{description}</p>
  <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:justify-center">
    <a class="btn btn-secondary" href={primaryHref} data-astro-prefetch>
      {primaryLabel}
    </a>
    {secondaryHref && secondaryLabel && (
      <a class="btn btn-primary" href={secondaryHref} data-astro-prefetch>
        {secondaryLabel}
      </a>
    )}
  </div>
</div>
